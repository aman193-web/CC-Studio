{
  "name": "cc-studio-issues",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit --noUnusedLocals",
    "format": "prettier --write src vite.config.ts index.html package.json tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.6",
    "gsap": "^3.14.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
